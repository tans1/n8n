    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const {order} = $input.first().json;\nconst round2 = x => Math.round((x + Number.EPSILON)*100)/100;\nconst subtotal = round2(order.items.reduce((sum,item) => sum + item.lineTotal,0));\nconst serviceFee = round2(subtotal * 0.10);  // Demo service fee: 10%\nconst deliveryFee = order.serviceType === 'room_service' ? 4 : 0;\nconst total = round2(subtotal + serviceFee + deliveryFee);\nconst isPriority = total >= 75 || order.items.reduce((n,item) => n + item.quantity,0) >= 6;\nconst orderId = 'HTL-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2,6).toUpperCase();\nreturn [{json:{...$input.first().json,orderId,createdAt:new Date().toISOString(),currency:'USD',bill:{subtotal,serviceFee,deliveryFee,total},isPriority}}];"
      },
