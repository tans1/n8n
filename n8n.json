    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Demo menu. Prices and stock are snapshots, not a live inventory database.\n// Edit this object to customize dishes, availability, or prices.\nconst MENU = {\n  burger:          {name:'Classic Burger',     price:12.50, stock:15,station:'KITCHEN'},\n  pizza:           {name:'Margherita Pizza',   price:16.00, stock:6, station:'KITCHEN'},\n  pasta:           {name:'Creamy Alfredo',     price:14.00, stock:7, station:'KITCHEN'},\n  club_sandwich:   {name:'Club Sandwich',      price:10.00, stock:8, station:'KITCHEN'},\n  caesar_salad:    {name:'Caesar Salad',       price:9.00,  stock:12,station:'KITCHEN'},\n  coffee:          {name:'Fresh Coffee',       price:4.00,  stock:20,station:'BAR'},\n  orange_juice:    {name:'Fresh Orange Juice', price:5.00,  stock:0, station:'BAR'}\n};\nconst {order} = $input.first().json;\nconst issues = [];\nconst items = order.items.map(({sku,quantity}) => {\n  const product = MENU[sku];\n  if (!product) { issues.push({sku,reason:'Item not found on menu'}); return {sku,quantity}; }\n  if (quantity > product.stock) issues.push({sku,reason:'Not enough stock',requested:quantity,available:product.stock});\n  return {sku,name:product.name,quantity,unitPrice:product.price,station:product.station,lineTotal:Number((product.price * quantity).toFixed(2))};\n});\nreturn [{json:{available:issues.length===0,order:{...order,items},issues}}];"
      },
