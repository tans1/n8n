        "jsCode": "const data = $input.first().json;\nconst kitchen = data.order.items.filter(x=>x.station==='KITCHEN').map(({name,quantity})=>({name,quantity}));\nconst bar = data.order.items.filter(x=>x.station==='BAR').map(({name,quantity})=>({name,quantity}));\nreturn [{json:{...data,kitchenTicket:{orderId:data.orderId,guestName:data.order.guestName,destination:data.destination,fulfillment:data.fulfillment,paymentMethod:data.order.paymentMethod,instructions:data.order.instructions,kitchen,bar,status:'PREP_PENDING'}}}];"
