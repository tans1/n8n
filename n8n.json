    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst issues = [];\nconst guestName = typeof body.guestName === 'string' ? body.guestName.trim() : '';\nconst serviceType = typeof body.serviceType === 'string' ? body.serviceType.trim().toLowerCase() : '';\nconst roomNumber = body.roomNumber == null ? '' : String(body.roomNumber).trim();\nconst paymentMethod = String(body.paymentMethod ?? (serviceType === 'room_service' ? 'charge_to_room' : 'pay_at_counter')).trim().toLowerCase();\nconst instructions = typeof body.instructions === 'string' ? body.instructions.trim().slice(0, 200) : '';\nif (guestName.length < 2 || guestName.length > 80) issues.push('guestName must have 2 to 80 characters');\nif (!['room_service','pickup'].includes(serviceType)) issues.push('serviceType must be room_service or pickup');\nif (serviceType === 'room_service' && !/^[0-9]{1,5}[A-Za-z]?$/.test(roomNumber)) issues.push('roomNumber is required for room service (e.g. 204)');\nif ((serviceType === 'room_service' && !['charge_to_room','pay_on_delivery'].includes(paymentMethod)) || (serviceType === 'pickup' && paymentMethod !== 'pay_at_counter')) issues.push('invalid paymentMethod for the selected serviceType');\nconst rows = Array.isArray(body.items) ? body.items : [];\nif (rows.length === 0 || rows.length > 10) issues.push('items must contain 1 to 10 entries');\nconst merged = new Map();\nfor (const row of rows) {\n  const sku = typeof row?.sku === 'string' ? row.sku.trim().toLowerCase() : '';\n  const qty = row?.quantity;\n  if (!/^[a-z][a-z0-9_]{1,39}$/.test(sku) || !Number.isInteger(qty) || qty < 1 || qty > 10) {\n    issues.push('each item needs a valid sku and integer quantity from 1 to 10');\n    continue;\n  }\n  merged.set(sku, (merged.get(sku) ?? 0) + qty);\n}\nconst items = [...merged].map(([sku, quantity]) => ({ sku, quantity }));\nif (items.some(x => x.quantity > 10)) issues.push('maximum 10 units per menu item');\nif (items.reduce((n,x) => n + x.quantity,0) > 20) issues.push('maximum 20 total units per order');\nreturn [{json:{valid:issues.length===0,issues,order:{guestName,serviceType,roomNumber: serviceType === 'room_service' ? roomNumber : null,paymentMethod,instructions,items}}}];"
      },
